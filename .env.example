# Environment Variables

# Ledger uses client-side storage only (localStorage/IndexedDB).
# No backend API keys or secrets are required for core gameplay.

# If you add optional integrations (e.g., analytics, AI APIs),
# add the corresponding variables below. Do NOT commit real values.

# Example: AI Service API Key (optional, for future features)
# VITE_AI_API_KEY=your_api_key_here

# Example: Analytics ID (optional, not used by default)
# VITE_ANALYTICS_ID=your_analytics_id

# App title shown in browser tab
VITE_APP_TITLE=Ledger - 财商教育模拟游戏
