# Environment Variables Example
# Copy this file to .env and fill in values as needed.
# .env files should NEVER be committed to version control.

# AI / LLM API Keys (for future AI features)
# NOTE: Ledger v2.0 does not use external AI APIs.
# All AI logic runs locally in the browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Analytics (not used in v2.0)
# Ledger does not collect user data.
GA_MEASUREMENT_ID=

# Deployment
# Vite base path for GitHub Pages (already set in vite.config.ts)
VITE_BASE=/ledger-game/

# Playtest (v2.2)
# 自动试玩目标地址。优先级：--url CLI > PLAYTEST_BASE_URL > 默认 localhost:5173/ledger-game
# 不配置时使用默认本地 dev server 的完整地址（含 vite base 路径）。
PLAYTEST_BASE_URL=http://localhost:5173/ledger-game
